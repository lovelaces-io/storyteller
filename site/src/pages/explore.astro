---
import Base from "../layouts/Base.astro";
import { scenarios } from "../content/scenarios";

const title = "Explore your Library";
const description = "Drive three small worlds — a checkout, a nightly sync, an AI agent working a ticket — and watch their stories arrive as a run inspector. Or drop your own stories.jsonl. Nothing leaves your browser.";
---

<Base title={`${title} — Storyteller`} description={description} path="/explore">
  <div class="container explore">
    <header class="explore-head">
      <h1>{title}</h1>
      <p class="lede">Every story Storyteller tells lands here. Drive one of the worlds below and watch it happen, or drop the file your own app writes. It stays on this page; nothing is uploaded.</p>
    </header>

    <div class="scenarios" data-scenarios>
      <div class="scenario-tabs" role="tablist" aria-label="Scenarios">
        {scenarios.map((scenario, index) => (
          <button type="button" role="tab" class="scenario-tab" data-scenario={scenario.id} aria-selected={index === 0 ? "true" : "false"}>{scenario.name}</button>
        ))}
      </div>
      {scenarios.map((scenario, index) => (
        <div class="scenario" role="tabpanel" data-scenario-panel={scenario.id} hidden={index !== 0}>
          <p class="scenario-tagline">{scenario.tagline}</p>
          <div class="scenario-controls">
            <label class="scenario-auto"><input type="checkbox" data-autorun={scenario.id} /> auto-run</label>
            <span class="scenario-or">or fire one:</span>
            {scenario.runs.map((run, runIndex) => (
              <button type="button" class={`scenario-run is-${run.outcome}`} data-run={`${scenario.id}:${runIndex}`}>
                <span class="scenario-dot" aria-hidden="true"></span>{run.label}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="explore-board" aria-label="Your Library">
      <div class="explore-toolbar">
        <span class="explore-status" id="explore-status" aria-live="polite"></span>
        <button type="button" class="copy-btn" id="copy-mermaid">copy as Mermaid</button>
        <button type="button" class="copy-btn" id="clear-board">clear</button>
      </div>
      <div class="view-demo" id="board-host"></div>
    </div>

    <div class="explore-own" aria-label="Load your own stories">
      <h2>Or your own</h2>
      <p>Drop the file a <code>fileStore</code> writes, or anything with one JSON object per line: stories, live beats, or both.</p>
      <div class="explore-start">
        <label class="dropzone" id="dropzone" for="file-input">
          <span class="dropzone-title">Drop <code>stories.jsonl</code> here</span>
          <span class="dropzone-sub">click to choose a file · nothing is uploaded</span>
          <input type="file" id="file-input" accept=".jsonl,.ndjson,.json,.txt,text/plain,application/json" hidden />
        </label>
        <details class="explore-paste">
          <summary>paste NDJSON instead</summary>
          <textarea id="paste-input" rows="4" spellcheck="false" placeholder='{"kind":"story","title":"Nightly sync failed", ...}'></textarea>
          <div class="explore-actions"><button type="button" class="copy-btn" id="load-paste">load pasted text</button></div>
        </details>
      </div>
      <p>Two lines in any Node app produce such a file, and <a href="/docs/library">the Library</a> is where they go to be asked questions:</p>
      <pre class="explore-code">import &#123; storeAudience &#125; from "@lovelaces-io/storyteller";
import &#123; fileStore &#125; from "@lovelaces-io/storyteller/store/file";

story.audience.add(storeAudience(fileStore("./stories.jsonl")));</pre>
    </div>
  </div>
</Base>

<script>
  import { liveStoryboard, toMermaid } from "@lovelaces-io/storyteller-view";
  import "@lovelaces-io/storyteller-view/style.css";
  import { scenarios, type Beat, type Run } from "../content/scenarios";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const boardHost = $<HTMLDivElement>("board-host");
  const status = $<HTMLElement>("explore-status");
  const clearButton = $<HTMLButtonElement>("clear-board");
  const fileInput = $<HTMLInputElement>("file-input");
  const dropzone = $<HTMLLabelElement>("dropzone");
  const pasteInput = $<HTMLTextAreaElement>("paste-input");

  type Record = ReturnType<ReturnType<typeof liveStoryboard>["stories"]>[number];
  let loaded = 0;
  let skipped = 0;
  let fromScenarios = 0;
  const live = liveStoryboard(boardHost, {
    title: "your Library",
    detail: "dialog",
    capacity: 200,
    onChange: (stories) => {
      const running = stories.filter((story) => story.running).length;
      status.textContent = stories.length
        ? `${stories.length} ${stories.length === 1 ? "story" : "stories"}${running ? `, ${running} running` : ""}${loaded ? ` · ${loaded} ${loaded === 1 ? "line" : "lines"} of yours` : ""}${skipped ? `, ${skipped} skipped` : ""} · nothing left your browser`
        : "Nothing yet. Fire a run above, or drop a file below.";
    },
  });

  // --- scenarios: a run plays out live, beat by beat, with chapters as their own stories
  const rid = () => Math.random().toString(16).slice(2, 8);
  const timers = new Set<number>();
  const later = (ms: number, fn: () => void) => { const t = window.setTimeout(() => { timers.delete(t); fn(); }, ms); timers.add(t); };

  function play(run: Run, origin = run.origin, parentStoryId?: string, done?: () => void) {
    const storyId = `${run.origin.who}-${rid()}`;
    const title = run.finish.title.replace("{order}", `ord_${rid().slice(0, 4)}`);
    const notes: { timestamp: string; sequence: number; note: string; level?: string; what?: unknown; where?: string; error?: unknown }[] = [];
    let clock = 0;
    let open = 0;
    const finish = () => {
      const first = Date.parse(notes[0]?.timestamp ?? new Date().toISOString());
      live.hear({ kind: "story", storyId, ...(parentStoryId ? { parentStoryId } : {}), timestamp: new Date().toISOString(), level: run.finish.level ?? "Information", title, origin, notes, durationMs: Date.now() - first, ...(run.finish.error ? { error: run.finish.error } : {}) });
      done?.();
    };
    run.beats.forEach((beat: Beat, index) => {
      clock += beat.after;
      later(clock, () => {
        const note = { timestamp: new Date().toISOString(), sequence: index, note: beat.note, ...(beat.level ? { level: beat.level } : {}), ...(beat.what !== undefined ? { what: beat.what } : {}), ...(beat.where ? { where: beat.where } : {}), ...(beat.error ? { error: beat.error } : {}) };
        notes.push(note);
        live.hear({ kind: "note", storyId, ...(parentStoryId ? { parentStoryId } : {}), origin, level: beat.level ?? "Information", ...note });
        if (beat.chapter) {
          open++;
          play({ label: "", outcome: "success", origin: run.origin, beats: beat.chapter.beats, finish: beat.chapter.finish }, beat.chapter.origin, storyId, () => { open--; });
        }
      });
    });
    // The story closes after its last beat — and after its chapters, which are short
    later(clock + 350, () => { const wait = () => (open ? later(150, wait) : finish()); wait(); });
  }

  const panels = document.querySelectorAll<HTMLElement>("[data-scenario-panel]");
  const tabs = document.querySelectorAll<HTMLButtonElement>(".scenario-tab");
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      for (const other of tabs) other.setAttribute("aria-selected", String(other === tab));
      for (const panel of panels) panel.hidden = panel.dataset["scenarioPanel"] !== tab.dataset["scenario"];
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-run]")) {
    button.addEventListener("click", () => {
      const [id, index] = button.dataset["run"]!.split(":");
      const scenario = scenarios.find((s) => s.id === id)!;
      fromScenarios++;
      play(scenario.runs[Number(index)]!);
    });
  }
  // Auto-run: the scenario's sequence, one run every few seconds, while the box is ticked
  const autoTimers = new Map<string, number>();
  for (const box of document.querySelectorAll<HTMLInputElement>("[data-autorun]")) {
    const id = box.dataset["autorun"]!;
    const scenario = scenarios.find((s) => s.id === id)!;
    let cursor = 0;
    const step = () => {
      if (!box.checked) return;
      play(scenario.runs[scenario.autoplay[cursor % scenario.autoplay.length]!]!);
      cursor++;
      autoTimers.set(id, window.setTimeout(step, 4500 + Math.random() * 2500));
    };
    box.addEventListener("change", () => {
      if (box.checked) step();
      else { clearTimeout(autoTimers.get(id)); autoTimers.delete(id); }
    });
  }

  // --- your own file: one JSON object per line (or one array), in slices so nothing freezes
  function load(text: string) {
    const trimmed = text.trim();
    if (!trimmed) return;
    if (trimmed.startsWith("[")) {
      try { for (const item of JSON.parse(trimmed) as unknown[]) { live.hear(item); loaded++; } } catch { skipped++; }
      live.flush();
      return;
    }
    const lines = trimmed.split("\n");
    let index = 0;
    const slice = () => {
      const end = Math.min(index + 2000, lines.length);
      for (; index < end; index++) {
        const line = lines[index]!.trim();
        if (!line) continue;
        try { live.hear(JSON.parse(line)); loaded++; } catch { skipped++; }
      }
      if (index < lines.length) setTimeout(slice, 0); else live.flush();
    };
    slice();
  }
  fileInput.addEventListener("change", () => { if (fileInput.files?.[0]) fileInput.files[0].text().then(load); });
  for (const type of ["dragenter", "dragover"]) dropzone.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.add("is-over"); });
  for (const type of ["dragleave", "drop"]) dropzone.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.remove("is-over"); });
  dropzone.addEventListener("drop", (event) => { const file = (event as DragEvent).dataTransfer?.files?.[0]; if (file) file.text().then(load); });
  document.addEventListener("paste", (event) => {
    if (event.target === pasteInput) return;
    const text = event.clipboardData?.getData("text");
    if (text && text.trim().startsWith("{")) { event.preventDefault(); load(text); }
  });
  $("load-paste").addEventListener("click", () => load(pasteInput.value));
  clearButton.addEventListener("click", () => { for (const t of timers) clearTimeout(t); timers.clear(); loaded = 0; skipped = 0; live.clear(); });
  $("copy-mermaid").addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("copy-mermaid");
    try { await navigator.clipboard.writeText(toMermaid(live.stories() as Record[])); button.textContent = "copied"; } catch { button.textContent = "copy failed"; }
    setTimeout(() => { button.textContent = "copy as Mermaid"; }, 1400);
  });

  // The page opens with the checkout world running, so the first thing a visitor sees is stories arriving
  const first = document.querySelector<HTMLInputElement>('[data-autorun="checkout"]');
  if (first) { first.checked = true; first.dispatchEvent(new Event("change")); }
</script>

<style>
  .explore { max-width: 1100px; }
  .explore-head { padding: 2.5rem 0 1rem; }
  .explore-head h1 { margin: 0 0 0.5rem; }
  .scenarios { margin: 0.5rem 0 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); }
  .scenario-tabs { display: flex; gap: 2px; padding: 8px 10px 0; border-bottom: 1px solid var(--border); }
  .scenario-tab { padding: 8px 12px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--text-muted); font: inherit; font-weight: 600; cursor: pointer; }
  .scenario-tab:hover { color: var(--text); }
  .scenario-tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--green); }
  .scenario { padding: 12px 14px 14px; }
  .scenario-tagline { margin: 0 0 10px; color: var(--text-muted); }
  .scenario-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .scenario-auto { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border: 1px solid var(--border); border-radius: 999px; font-size: 0.9em; color: var(--text); cursor: pointer; }
  .scenario-auto:has(input:checked) { border-color: var(--green-dim); color: var(--green); }
  .scenario-or { color: var(--text-muted); font-size: 0.9em; margin: 0 2px; }
  .scenario-run { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-elevated); color: var(--text); font: inherit; font-size: 0.9em; cursor: pointer; transition: border-color 0.15s, transform 0.05s; }
  .scenario-run:hover { border-color: var(--green-dim); }
  .scenario-run:active { transform: translateY(1px); }
  .scenario-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .scenario-run.is-warning .scenario-dot { background: var(--warn); }
  .scenario-run.is-failure .scenario-dot { background: var(--oops); }
  .explore-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 10px; }
  .explore-status { flex: 1; min-height: 1.4em; color: var(--text-muted); font-family: var(--font-mono); font-size: 12px; }
  .explore-own { margin: 2.5rem 0 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .explore-own h2 { margin: 0 0 0.5rem; }
  .explore-own p { color: var(--text-muted); }
  .explore-start { display: grid; gap: 10px; margin: 1rem 0; }
  .dropzone { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 84px; padding: 12px 16px; border: 1px dashed var(--green-dim); border-radius: var(--radius); background: var(--bg-surface); color: var(--text); cursor: pointer; text-align: center; transition: border-color 0.15s, background 0.15s; }
  .dropzone:hover, .dropzone.is-over { border-color: var(--green); background: var(--bg-elevated); }
  .dropzone-title { font-weight: 600; }
  .dropzone-sub { color: var(--text-muted); font-size: 0.9em; }
  .explore-paste { color: var(--text-muted); font-size: 0.9em; }
  .explore-paste summary { cursor: pointer; }
  .explore-paste textarea { width: 100%; box-sizing: border-box; margin-top: 8px; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); color: var(--text); font-family: var(--font-mono); font-size: 12px; resize: vertical; }
  .explore-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .explore-code { padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); font-family: var(--font-mono); font-size: 12.5px; overflow-x: auto; }
  .view-demo {
    --stv-bg: var(--bg-surface); --stv-fg: var(--text); --stv-muted: var(--text-muted); --stv-border: var(--border); --stv-surface: var(--bg-elevated);
    --stv-info: var(--green); --stv-warn: var(--warn); --stv-error: var(--oops); --stv-accent: #7fb3ff;
    --stv-font: var(--font-body); --stv-mono: var(--font-mono); --stv-radius: var(--radius); --stv-size: 13px;
    min-width: 0;
  }
</style>
