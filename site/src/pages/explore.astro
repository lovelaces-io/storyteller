---
import Base from "../layouts/Base.astro";

const title = "Explore your stories";
const description = "Drop a stories.jsonl or paste NDJSON and see your runs as a storyboard: every story a panel, every failure obvious, every step one click from its raw data. Nothing leaves your browser.";
---

<Base title={`${title} — Storyteller`} description={description} path="/explore">
  <div class="container explore">
    <header class="explore-head">
      <h1>{title}</h1>
      <p class="lede">Drop the file a <code>fileStore</code> writes, or anything with one JSON object per line: stories, live beats, or both. It stays on this page. Nothing is uploaded.</p>
    </header>

    <section class="explore-input" aria-label="Load stories">
      <div class="explore-start">
        <button type="button" class="btn btn-primary" id="load-sample">Show me a sample run</button>
        <label class="dropzone" id="dropzone" for="file-input">
          <span class="dropzone-title">or drop your own <code>stories.jsonl</code></span>
          <span class="dropzone-sub">click to choose a file · nothing is uploaded</span>
          <input type="file" id="file-input" accept=".jsonl,.ndjson,.json,.txt,text/plain,application/json" hidden />
        </label>
      </div>
      <details class="explore-paste">
        <summary>paste NDJSON instead</summary>
        <textarea id="paste-input" rows="4" spellcheck="false" placeholder='{"kind":"story","title":"Nightly sync failed", ...}'></textarea>
        <div class="explore-actions">
          <button type="button" class="copy-btn" id="load-paste">load pasted text</button>
        </div>
      </details>
      <p class="explore-status" id="explore-status" aria-live="polite"></p>
    </section>

    <section class="explore-board" id="explore-board" hidden aria-label="Storyboard">
      <div class="explore-toolbar">
        <button type="button" class="copy-btn" id="copy-mermaid">copy as Mermaid</button>
        <button type="button" class="copy-btn" id="clear-board">clear</button>
      </div>
      <div class="view-demo" id="board-host"></div>
      <div class="view-demo explore-detail" id="detail-host" hidden></div>
    </section>

    <section class="explore-how">
      <h2>Where a file like that comes from</h2>
      <p>Two lines in any Node app, and every story it tells lands in a file you can drop here:</p>
      <pre class="explore-code">import &#123; storeAudience &#125; from "@lovelaces-io/storyteller";
import &#123; fileStore &#125; from "@lovelaces-io/storyteller/store/file";

story.audience.add(storeAudience(fileStore("./stories.jsonl")));</pre>
      <p>Or stream beats live with <code>STORYTELLER_FORMAT=ndjson</code> and paste what came out. Redaction happened where the story was written; this page redacts nothing and keeps nothing. To keep stories somewhere and ask them questions, see <a href="/docs/library">The Library</a>.</p>
    </section>
  </div>
</Base>

<script>
  import { createStoryboard, liveStoryboard, renderStory, toMermaid } from "@lovelaces-io/storyteller-view";
  import "@lovelaces-io/storyteller-view/style.css";
  import demoRun from "../content/demoRun.json";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const dropzone = $<HTMLLabelElement>("dropzone");
  const fileInput = $<HTMLInputElement>("file-input");
  const pasteInput = $<HTMLTextAreaElement>("paste-input");
  const status = $<HTMLParagraphElement>("explore-status");
  const boardSection = $<HTMLElement>("explore-board");
  const boardHost = $<HTMLDivElement>("board-host");
  const detailHost = $<HTMLDivElement>("detail-host");
  const clearButton = $<HTMLButtonElement>("clear-board");

  type Record = Parameters<typeof createStoryboard>[0][number];
  // The live controller reassembles beats into stories and ignores anything else;
  // its board is never shown — the filtered board below is what the page draws.
  let live = liveStoryboard(document.createElement("div"), { capacity: 100_000 });
  let loaded = 0;
  let skipped = 0;
  let sample = false;

  let board: ReturnType<typeof createStoryboard> | undefined;
  function draw() {
    const stories = live.stories() as Record[];
    if (!board) {
      board = createStoryboard(stories, {
        title: "your stories",
        onSelect: (story) => {
          detailHost.hidden = false;
          detailHost.replaceChildren(renderStory(story, { expandDepth: 1 }));
          detailHost.scrollIntoView({ block: "nearest", behavior: "smooth" });
        },
      });
      boardHost.replaceChildren(board.element);
    } else {
      board.update(stories);
    }
    boardSection.hidden = false;
    const total = stories.length;
    status.textContent = sample
      ? `A sample run: ${total} stories. Drop your own stories.jsonl to see yours the same way; nothing is uploaded.`
      : `${total} ${total === 1 ? "story" : "stories"} from ${loaded} ${loaded === 1 ? "line" : "lines"}${skipped ? `, ${skipped} skipped` : ""}. Nothing left your browser.`;
  }

  /** Parse one JSON object per line (or one JSON array), in slices so a big file does not freeze the page */
  function load(text: string, onDone: () => void) {
    const trimmed = text.trim();
    if (!trimmed) return onDone();
    if (trimmed.startsWith("[")) {
      try {
        for (const item of JSON.parse(trimmed) as unknown[]) { live.hear(item); loaded++; }
      } catch { skipped++; }
      return onDone();
    }
    const lines = trimmed.split("\n");
    let index = 0;
    const slice = () => {
      const end = Math.min(index + 2000, lines.length);
      for (; index < end; index++) {
        const line = lines[index]!.trim();
        if (!line) continue;
        try { live.hear(JSON.parse(line)); loaded++; } catch { skipped++; }
      }
      if (index < lines.length) { status.textContent = `reading… ${index} of ${lines.length} lines`; setTimeout(slice, 0); }
      else onDone();
    };
    slice();
  }

  function reset() {
    live.destroy();
    live = liveStoryboard(document.createElement("div"), { capacity: 100_000 });
    loaded = 0; skipped = 0; board = undefined; sample = false;
    boardHost.replaceChildren(); detailHost.replaceChildren(); detailHost.hidden = true;
  }
  function loadText(text: string) { load(text, () => { live.flush(); draw(); }); }
  function loadFile(file: File) { if (sample) reset(); file.text().then(loadText); }
  function loadSample() { reset(); sample = true; loadText((demoRun as unknown[]).map((record) => JSON.stringify(record)).join("\n")); }

  fileInput.addEventListener("change", () => { if (fileInput.files?.[0]) loadFile(fileInput.files[0]); });
  for (const type of ["dragenter", "dragover"]) dropzone.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.add("is-over"); });
  for (const type of ["dragleave", "drop"]) dropzone.addEventListener(type, (event) => { event.preventDefault(); dropzone.classList.remove("is-over"); });
  dropzone.addEventListener("drop", (event) => { const file = (event as DragEvent).dataTransfer?.files?.[0]; if (file) loadFile(file); });
  document.addEventListener("paste", (event) => {
    if (event.target === pasteInput) return;
    const text = event.clipboardData?.getData("text");
    if (text && text.trim().startsWith("{")) { event.preventDefault(); if (sample) reset(); loadText(text); }
  });
  $("load-paste").addEventListener("click", () => { if (sample) reset(); loadText(pasteInput.value); });
  $("load-sample").addEventListener("click", loadSample);
  clearButton.addEventListener("click", () => { reset(); boardSection.hidden = true; status.textContent = ""; });
  // The page opens on the sample, so the first thing a visitor sees is the tool working
  loadSample();
  $("copy-mermaid").addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("copy-mermaid");
    try { await navigator.clipboard.writeText(toMermaid(live.stories() as Record[])); button.textContent = "copied"; }
    catch { button.textContent = "copy failed"; }
    setTimeout(() => { button.textContent = "copy as Mermaid"; }, 1400);
  });
</script>

<style>
  .explore { max-width: 1100px; }
  .explore-head { padding: 2.5rem 0 1rem; }
  .explore-head h1 { margin: 0 0 0.5rem; }
  .explore-input { display: grid; gap: 10px; margin: 0 0 1.25rem; }
  .explore-start { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: stretch; }
  @media (max-width: 640px) { .explore-start { grid-template-columns: 1fr; } }
  .explore-start .btn { align-self: center; white-space: nowrap; }
  .explore-paste { color: var(--text-muted); font-size: 0.9em; }
  .explore-paste summary { cursor: pointer; }
  .explore-paste textarea { margin-top: 8px; }
  .dropzone { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 64px; padding: 10px 16px; border: 1px dashed var(--green-dim); border-radius: var(--radius); background: var(--bg-surface); color: var(--text); cursor: pointer; text-align: center; transition: border-color 0.15s, background 0.15s; }
  .dropzone:hover, .dropzone.is-over { border-color: var(--green); background: var(--bg-elevated); }
  .dropzone-title { font-weight: 600; }
  .dropzone-sub { color: var(--text-muted); font-size: 0.9em; }
  .explore-paste textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); color: var(--text); font-family: var(--font-mono); font-size: 12px; resize: vertical; }
  .explore-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .explore-status { min-height: 1.4em; margin: 0; color: var(--text-muted); font-family: var(--font-mono); font-size: 12px; }
  .explore-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: flex-end; margin: 0 0 10px; }
  .explore-detail { display: grid; gap: 16px; margin-top: 16px; }
  .explore-how { margin: 2.5rem 0 3rem; }
  .explore-code { padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-surface); font-family: var(--font-mono); font-size: 12.5px; overflow-x: auto; }
  .view-demo {
    --stv-bg: var(--bg-surface); --stv-fg: var(--text); --stv-muted: var(--text-muted); --stv-border: var(--border); --stv-surface: var(--bg-elevated);
    --stv-info: var(--green); --stv-warn: var(--warn); --stv-error: var(--oops); --stv-accent: #7fb3ff;
    --stv-font: var(--font-body); --stv-mono: var(--font-mono); --stv-radius: var(--radius); --stv-size: 13px;
    min-width: 0;
  }
</style>
