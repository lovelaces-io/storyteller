---
import Base from "./Base.astro";
import AgentLinks from "../components/AgentLinks.astro";

interface Props {
  title: string;
  description?: string;
  path: string;
  /** The page's h2 sections, for the right rail. Static, so it reads without JS. */
  sections?: { id: string; label: string }[];
}

const { title, description, path, sections = [] } = Astro.props;

const groups = [
  { heading: "start here", pages: [
    { href: "/docs", label: "Getting started" },
    { href: "/docs/narration", label: "Collected & live" },
    { href: "/docs/reporting", label: "Reporting & context" },
  ] },
  { heading: "deliver", pages: [
    { href: "/docs/audiences", label: "Audiences" },
    { href: "/docs/chapters", label: "Chapters" },
  ] },
  { heading: "read", pages: [
    { href: "/docs/view", label: "Story view" },
  ] },
  { heading: "for agents", pages: [
    { href: "/docs/agents", label: "Agents & init" },
  ] },
  { heading: "reference", pages: [
    { href: "/docs/api", label: "API" },
    { href: "/docs/examples", label: "Examples" },
    { href: "/docs/migration", label: "Migrating from 0.2" },
    { href: "/docs/faq", label: "FAQ" },
  ] },
];

const flat = groups.flatMap((group) => group.pages);
const index = flat.findIndex((page) => page.href === path);
const current = index >= 0 ? flat[index] : undefined;
const previous = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;

const siteUrl = "https://storyteller.lovelaces.io";
const schema = [
  { "@type": "TechArticle", headline: title, description, url: `${siteUrl}${path}`, about: { "@id": `${siteUrl}/#software` }, author: { "@id": `${siteUrl}/#org` }, isPartOf: { "@id": `${siteUrl}/#site` } },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Storyteller", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Docs", item: `${siteUrl}/docs` },
    ...(current && path !== "/docs" ? [{ "@type": "ListItem", position: 3, name: current.label, item: `${siteUrl}${path}` }] : []),
  ] },
];
---

<Base title={`${title} — Storyteller`} description={description} path={path} schema={schema}>
  <div class="container docs">
    <nav class="docs-nav" aria-label="Documentation">
      {groups.map((group) => (
        <div class="docs-nav-group">
          <p class="docs-nav-heading">{group.heading}</p>
          {group.pages.map((page) => (
            <a href={page.href} class={page.href === path ? "active" : undefined} aria-current={page.href === path ? "page" : undefined}>{page.label}</a>
          ))}
        </div>
      ))}
      <div class="docs-nav-group">
        <p class="docs-nav-heading">machine-readable</p>
        <a href="/llms.txt">llms.txt</a>
        <a href="/llms-full.txt">llms-full.txt</a>
      </div>
    </nav>

    <article class="docs-content" data-pagefind-body>
      <slot />
      <AgentLinks />
      <nav class="docs-prev-next" aria-label="Pagination">
        {previous ? <a href={previous.href}><span class="docs-prev-next-label">previous</span>{previous.label}</a> : <span />}
        {next ? <a href={next.href} class="next"><span class="docs-prev-next-label">next</span>{next.label}</a> : <span />}
      </nav>
    </article>

    {sections.length > 1 && (
      <aside class="docs-rail" aria-label="On this page">
        <p class="docs-nav-heading">on this page</p>
        {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
      </aside>
    )}
  </div>
</Base>
