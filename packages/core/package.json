{
  "name": "@lovelaces-io/storyteller",
  "version": "0.4.0",
  "description": "Zero-dependency TypeScript logging for humans and AI agents. Report work as it happens, get one clean structured record when it's done.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelaces-io/storyteller.git"
  },
  "author": "Lovelaces <contact@lovelaces.io> (https://lovelaces.io)",
  "homepage": "https://storyteller.lovelaces.io",
  "bugs": {
    "url": "https://github.com/lovelaces-io/storyteller/issues"
  },
  "keywords": [
    "logging",
    "logger",
    "structured-logging",
    "storyteller",
    "events",
    "observability",
    "typescript",
    "story-logging",
    "structured-events",
    "zero-dependencies",
    "audit-log",
    "context-logging",
    "ai-agents",
    "agents",
    "llm",
    "live-logging",
    "log-streaming",
    "ndjson",
    "mcp",
    "agent-observability",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./store/file": {
      "types": "./dist/store/file.d.ts",
      "import": "./dist/store/file.js",
      "require": "./dist/store/file.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "snippets",
    "llms.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:console": "npm run build && node ./scripts/consoleTest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && cp ../../README.md ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "bin": {
    "storyteller": "dist/cli.cjs"
  },
  "typesVersions": {
    "*": {
      "store/file": [
        "./dist/store/file.d.ts"
      ]
    }
  }
}
